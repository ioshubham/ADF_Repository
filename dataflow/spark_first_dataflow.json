{
	"name": "spark_first_dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dataflow_source",
						"type": "DatasetReference"
					},
					"name": "SourceCSV"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dataflow_sink",
						"type": "DatasetReference"
					},
					"name": "Finalaggegrate"
				}
			],
			"transformations": [
				{
					"name": "selectCol"
				},
				{
					"name": "filterRows"
				},
				{
					"name": "splitPaymentMethod"
				},
				{
					"name": "derivedColumn"
				},
				{
					"name": "aggregateProductId"
				},
				{
					"name": "alterRow"
				}
			],
			"scriptLines": [
				"source(output(",
				"          transaction_id as short,",
				"          transactional_date as timestamp,",
				"          product_id as string,",
				"          customer_id as short,",
				"          payment as string,",
				"          credit_card as long,",
				"          loyalty_card as boolean,",
				"          cost as double,",
				"          quantity as short,",
				"          price as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SourceCSV",
				"SourceCSV select(mapColumn(",
				"          transaction_id,",
				"          transactional_date,",
				"          product_id,",
				"          customer_id,",
				"          payment,",
				"          price",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectCol",
				"selectCol filter(customer_id != 12) ~> filterRows",
				"filterRows split(payment == 'visa',",
				"     payment == \"mastercard\",",
				"     disjoint: false) ~> splitPaymentMethod@(visa, mastercard, amex)",
				"splitPaymentMethod@amex derive(payment = coalesce(payment,\"not available\")) ~> derivedColumn",
				"splitPaymentMethod@visa aggregate(groupBy(customer_id),",
				"     product_id = max(product_id)) ~> aggregateProductId",
				"aggregateProductId alterRow(insertIf(1==1)) ~> alterRow",
				"alterRow sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Finalaggegrate"
			]
		}
	}
}